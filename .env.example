# ==============================================================================
# Configuração do Tutor IA (Azure AI Foundry / Azure OpenAI)
# ==============================================================================
# Copie este arquivo para .env e preencha suas chaves:
# cp .env.example .env

# Exemplo de Endpoint Azure AI Foundry (Chat Completions REST API):
# https://<seu-recurso>.openai.azure.com/openai/deployments/<nome-do-modelo>/chat/completions?api-version=2024-02-15-preview
# ou endpoint serverless de Foundry:
# https://<seu-deployment>.services.ai.azure.com/models/chat/completions
AZURE_AI_ENDPOINT=https://seu-recurso.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2024-02-15-preview

# Chave de API da Azure (Primary Key / API Key gerada no portal da Foundry):
AZURE_AI_API_KEY=sua_chave_azure_aqui
